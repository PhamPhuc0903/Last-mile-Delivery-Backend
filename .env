# ==============================
# APP
# ==============================

NODE_ENV=development

# ==============================
# POSTGRES
# ==============================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=delivery_db
POSTGRES_USER=delivery
POSTGRES_PASSWORD=delivery

# ==============================
# REDIS
# ==============================

REDIS_HOST=redis
REDIS_PORT=6379

# ==============================
# RABBITMQ
# ==============================

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ==============================
# JWT
# ==============================

JWT_ACCESS_SECRET=super-secret-access-key
JWT_REFRESH_SECRET=super-secret-refresh-key

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ==============================
# OPENAI
# ==============================

OPENAI_API_KEY=

# ==============================
# SERVICES
# ==============================

AUTH_SERVICE_URL=http://auth-service:3000
USER_SERVICE_URL=http://user-service:3000
ORDER_SERVICE_URL=http://order-service:3000
DRIVER_SERVICE_URL=http://driver-service:3000
TRACKING_SERVICE_URL=http://tracking-service:3000
DISPATCH_SERVICE_URL=http://dispatch-service:3000
NOTIFICATION_SERVICE_URL=http://notification-service:3000
AI_SERVICE_URL=http://ai-service:3000
CHATBOT_SERVICE_URL=http://chatbot-service:3000
ADMIN_SERVICE_URL=http://admin-service:3000